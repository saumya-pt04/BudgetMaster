<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - BudgetMaster</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="@Url.Action("Index", "Budget")">BudgetMaster</a>
            <div class="collapse navbar-collapse">
                @if (Session["UserId"] != null)
                {
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Budget")">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("AddIncome", "Budget")">+ Income</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("AddExpense", "Budget")">+ Expense</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("SetBudget", "Budget")">Monthly Budget</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Transactions", "Budget")">Transactions</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Reports", "Budget")">Reports</a></li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item"><a class="nav-link text-white" href="@Url.Action("Profile", "Account")">@Session["FullName"]</a></li>
                        <li class="nav-item"><a class="nav-link btn btn-sm btn-outline-light ms-2" href="@Url.Action("Logout", "Account")">Logout</a></li>
                    </ul>
                }
                else
                {
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Login", "Account")">Login</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Register", "Account")">Register</a></li>
                    </ul>
                }
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @RenderBody()
    </div>
</body>
</html>