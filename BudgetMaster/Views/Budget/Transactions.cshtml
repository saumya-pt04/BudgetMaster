@model List<BudgetMaster.Models.Expense>
    @{ ViewBag.Title = "Transaction History"; }

    <div class="card p-4 shadow-sm">
        <h4>Expense Transaction History</h4>
        @using (Html.BeginForm("Transactions", "Budget", FormMethod.Get, new { @class = "row g-2 my-3" }))
        {
            <div class="col-md-4">
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Search title or notes..." class="form-control" />
            </div>
            <div class="col-md-3">
                @Html.DropDownList("categoryId", new SelectList(ViewBag.Categories, "CategoryId", "CategoryName", ViewBag.SelectedCategory), "All Categories", new { @class = "form-select" })
            </div>
            <div class="col-md-3">
                <input type="month" name="month" value="@ViewBag.SelectedMonth" class="form-control" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
            </div>
        }

        <table class="table table-striped table-bordered">
            <thead>
                <tr><th>Date</th><th>Title</th><th>Category</th><th>Notes</th><th>Amount</th></tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td>@e.ExpenseDate.ToString("dd-MM-yyyy")</td>
                        <td>@e.Title</td>
                        <td>@e.CategoryName</td>
                        <td>@e.Notes</td>
                        <td class="text-danger">₹@e.Amount.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
