@model BudgetMaster.Models.Income
@{ ViewBag.Title = "Add Income"; }

<div class="col-md-6 card p-4 shadow-sm">
    <h4>Add Income</h4>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label>Income Source (e.g., Salary, Freelance)</label>
            @Html.TextBoxFor(m => m.Source, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Source, "", new { @class = "text-danger" })
        </div>
        <div class="mb-3">
            <label>Amount (₹)</label>
            @Html.TextBoxFor(m => m.Amount, new { @class = "form-control", type = "number", step = "0.01" })
        </div>
        <div class="mb-3">
            <label>Date</label>
            @Html.TextBoxFor(m => m.IncomeDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
        </div>
        <div class="mb-3">
            <label>Notes</label>
            @Html.TextAreaFor(m => m.Notes, new { @class = "form-control" })
        </div>
        <button type="submit" class="btn btn-success">Save Income</button>
    }
</div>