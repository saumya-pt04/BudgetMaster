@model BudgetMaster.Models.DashboardViewModel
@{ ViewBag.Title = "Monthly Reports"; }

<div class="card p-4 shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Monthly Financial Report (@ViewBag.Month)</h4>
        @using (Html.BeginForm("Reports", "Budget", FormMethod.Get, new { @class = "d-flex gap-2" }))
        {
            <input type="month" name="month" value="@ViewBag.Month" class="form-control" />
            <button type="submit" class="btn btn-primary">Generate</button>
            <button type="button" onclick="window.print()" class="btn btn-outline-secondary">Print</button>
        }
    </div>

    <div class="row mb-4">
        <div class="col-md-4"><strong>Monthly Income:</strong> <span class="text-success">₹@Model.TotalIncome.ToString("N2")</span></div>
        <div class="col-md-4"><strong>Monthly Expenses:</strong> <span class="text-danger">₹@Model.TotalExpenses.ToString("N2")</span></div>
        <div class="col-md-4"><strong>Net Monthly Savings:</strong> <span class="text-primary">₹@Model.NetSavings.ToString("N2")</span></div>
    </div>

    <h5>Spending by Category</h5>
    <table class="table table-bordered">
        <thead class="table-light"><tr><th>Category</th><th>Total Spent (₹)</th></tr></thead>
        <tbody>
            @foreach (var cat in Model.CategoryBreakdown)
            {
                <tr><td>@cat.Key</td><td>₹@cat.Value.ToString("N2")</td></tr>
            }
        </tbody>
    </table>
</div>