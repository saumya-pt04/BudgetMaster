@model BudgetMaster.Models.Expense
@{ ViewBag.Title = "Add Expense"; }

<div class="col-md-6 card p-4 shadow-sm">
    <h4>Add Expense</h4>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label>Expense Title</label>
            @Html.TextBoxFor(m => m.Title, new { @class = "form-control" })
        </div>
        <div class="mb-3">
            <label>Category</label>
            @Html.DropDownListFor(m => m.CategoryId, new SelectList(ViewBag.Categories, "CategoryId", "CategoryName"), "-- Select Category --", new { @class = "form-select" })
        </div>
        <div class="mb-3">
            <label>Amount (₹)</label>
            @Html.TextBoxFor(m => m.Amount, new { @class = "form-control", type = "number", step = "0.01" })
        </div>
        <div class="mb-3">
            <label>Date</label>
            @Html.TextBoxFor(m => m.ExpenseDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
        </div>
        <div class="mb-3">
            <label>Notes</label>
            @Html.TextAreaFor(m => m.Notes, new { @class = "form-control" })
        </div>
        <button type="submit" class="btn btn-danger">Save Expense</button>
    }
</div>