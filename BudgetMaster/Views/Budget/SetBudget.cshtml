@model BudgetMaster.Models.Budget
@{ ViewBag.Title = "Create Monthly Budget"; }

<div class="col-md-5 card p-4 shadow-sm">
    <h4>Set Monthly Budget Limit</h4>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label>Month (YYYY-MM)</label>
            @Html.TextBoxFor(m => m.MonthYear, new { @class = "form-control", type = "month" })
        </div>
        <div class="mb-3">
            <label>Monthly Spending Limit (₹)</label>
            @Html.TextBoxFor(m => m.MonthlyLimit, new { @class = "form-control", type = "number", step = "0.01" })
        </div>
        <button type="submit" class="btn btn-primary">Save Budget</button>
    }
</div>